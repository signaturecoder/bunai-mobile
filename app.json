{
  "expo": {
    "name": "Bunai App",
    "slug": "bunai-app",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/bunai-logo.png",
    "scheme": "bunai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bunai.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7c3aed"
      },
      "package": "com.bunai.mobile",
      "permissions": [
        "android.permission.USB_PERMISSION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bunai-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#7c3aed"
        }
      ],
      "expo-font"
    ],
    "description": "Bunai mobile application to view and manage designs",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c27f91e-b3b6-4711-a1ee-0df735b4f8c3"
      }
    },
    "owner": "bunai-app"
  }
}
